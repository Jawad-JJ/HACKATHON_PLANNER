# Copy to .env (never commit .env). Use a model from the organizers' SMALL-MODEL LIST for the +10 bonus.
# Test first:  python scripts/check_model.py

# Primary model. Providers: gemini | groq | openai | ollama  (any OpenAI-compatible endpoint via LLM_BASE_URL)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Optional fallback, used only if a call to the primary fails (it is traced under its own model name)
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
# OPENAI_API_KEY=

# Other options
# GROQ_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1     # e.g. Ollama: LLM_PROVIDER=ollama, LLM_MODEL=qwen2.5:3b
# LLM_TIMEOUT=40                             # seconds per call
# LLM_JSON_MODE=1                            # set 0 if the endpoint rejects response_format
