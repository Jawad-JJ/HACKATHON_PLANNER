# Copy to .env (never commit .env). Pick a model from the organizers' SMALL-MODEL LIST for the +10 bonus.

# groq | gemini | openai | ollama   (any OpenAI-compatible endpoint also works via LLM_BASE_URL)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# Key for the chosen provider (only the one you use)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional
# LLM_BASE_URL=http://localhost:11434/v1     # e.g. Ollama on this laptop: LLM_PROVIDER=ollama, LLM_MODEL=qwen2.5:3b
# LLM_TIMEOUT=40                             # seconds per call
# LLM_JSON_MODE=1                            # 0 if the endpoint rejects response_format
